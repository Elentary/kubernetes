      "type": "table",
      "gridPos": {
        "x": 18,
        "y": 18,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_info{namespace=\"$workload_ns\", pod=\"$workload_pod\"}",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "created_by_kind": true,
              "created_by_name": true,
              "host_ip": true,
              "pod_ip": true,
              "uid": true
            },
            "renameByName": {
              "node": "node",
              "namespace": "namespace",
              "pod": "pod"
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "node": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
