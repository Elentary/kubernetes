    {
      "id": 7,
      "title": "Score Plugin p95 Latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, plugin) (rate(scheduler_plugin_execution_duration_seconds_bucket{profile=\"better-scheduler\", extension_point=\"Score\"}[$__rate_interval])))",
          "legendFormat": "{{plugin}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
